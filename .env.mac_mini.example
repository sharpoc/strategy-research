TUSHARE_TOKEN=your_tushare_token
TUSHARE_HTTP_URL=http://lianghua.nanyangqiankun.top

# Default holder slot now runs 财报催化臻选.
# holder_chip_enhanced_screening still overrides these from ops/run_mac_mini_holder_chip_pipeline.sh.
HOLDER_CONFIG_FILE=configs/financial_report_catalyst_best.json
HOLDER_EXPORT_PREFIX=financial_report_catalyst_

# Where to write runtime logs and exports.
PIPELINE_LOG_DIR=ops/logs
HOLDER_EXPORT_ROOT=output/jupyter-notebook/financial_report_catalyst_exports
HOLDER_REPORT_ROOT=
HOLDER_MIN_START_HHMM=2000
HOLDER_RETRY_ENABLED=true
HOLDER_MAX_ATTEMPTS=12
HOLDER_RETRY_SLEEP_SEC=900
HOLDER_RETRY_DEADLINE_HHMM=2355

# Optional sync hook after a successful daily run.
# Example:
# LAB_SYNC_SCRIPT=/Users/lvxue/work/策略实验室/scripts/sync_holder_result_from_mac_mini.sh
LAB_SYNC_SCRIPT=
LAB_SYNC_ENV_FILE=
APP_INTERNAL_API_STRATEGY_ID=

# Event conviction strategy pipeline, scheduled on Mac mini after the holder/chip jobs.
EVENT_CONVICTION_CONFIG_FILE=configs/event_conviction_quality_first_v2.json
EVENT_CONVICTION_EXPORT_ROOT=output/jupyter-notebook/event_conviction_exports
EVENT_CONVICTION_API_SLEEP_SEC=0.05
EVENT_CONVICTION_PIPELINE_LOG_DIR=ops/logs
EVENT_CONVICTION_MIN_START_HHMM=2000
EVENT_CONVICTION_RETRY_ENABLED=true
EVENT_CONVICTION_MAX_ATTEMPTS=8
EVENT_CONVICTION_RETRY_SLEEP_SEC=600
EVENT_CONVICTION_RETRY_DEADLINE_HHMM=2355
LAB_EVENT_SYNC_SCRIPT=
LAB_EVENT_SYNC_ENV_FILE=

# Tail rebound strategy pipeline, scheduled on Mac mini at 14:30 by launchd.
REBOUND_STRATEGY_ID=tail_rebound_screening
REBOUND_TOP_N=5
REBOUND_REPORT_ROOT=output/rebound_reports
REBOUND_PIPELINE_LOG_DIR=ops/logs
REBOUND_RATER_PROJECT_ROOT=vendor/tushare-stock-rater
REBOUND_RETRY_ENABLED=true
REBOUND_MAX_ATTEMPTS=4
REBOUND_RETRY_SLEEP_SEC=300
REBOUND_RETRY_DEADLINE_HHMM=1515
APP_INTERNAL_API_BASE_URL=https://www.celab.xin
APP_INTERNAL_API_TOKEN=
APP_INTERNAL_API_MAX_ATTEMPTS=3
APP_INTERNAL_API_RETRY_SLEEP_SECONDS=2

